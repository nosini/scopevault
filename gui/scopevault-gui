        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title="Vault")
        self.state_row = text_row("State", "…")
        self.lock_button = Gtk.Button(label="Lock", action_name="win.lock", valign=Gtk.Align.CENTER)
        self.unlock_button = Gtk.Button(label="Unlock…", action_name="win.unlock", valign=Gtk.Align.CENTER)
        self.unlock_button.add_css_class("suggested-action")
        self.state_row.add_suffix(self.lock_button)
        self.state_row.add_suffix(self.unlock_button)
        group.add(self.state_row)
        self.dir_row = text_row("Vault directory", "…")
        self.dir_row.set_subtitle_selectable(True)
        group.add(self.dir_row)
        self.clients_row = text_row("Clients", "…")
        group.add(self.clients_row)
        page.add(group)

        group = Adw.PreferencesGroup(title="Password and backups")
        row = text_row("Master password", "The daemon asks for the old and the new password")
        row.add_suffix(Gtk.Button(label="Change…", action_name="win.change-password", valign=Gtk.Align.CENTER))
        group.add(row)
        row = text_row("Backup", "An encrypted copy; it opens with the current master password")
        row.add_suffix(Gtk.Button(label="Back Up…", action_name="win.backup", valign=Gtk.Align.CENTER))
        group.add(row)
        page.add(group)

        group = Adw.PreferencesGroup(
            title="Offline operations",
            description="Restore, import and export need the daemon stopped. "
            "Run them with scopevault-admin in a terminal (see docs/INSTALL.md).",
