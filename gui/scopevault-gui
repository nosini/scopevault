    def build_grants_page(self) -> Gtk.Widget:
        self.grants_group = Adw.PreferencesGroup(
            title="Grants",
            description="Items one scope shares with another. The grantee sees them in its Shared collection. "
            "Share items from the Scopes page.",
        )
        page = Adw.PreferencesPage()
        page.add(self.grants_group)
        self.grant_rows: list[Gtk.Widget] = []
        self.grants_stack = Gtk.Stack()
        self.grants_stack.add_named(page, "list")
        self.grants_stack.add_named(self.locked_page(), "locked")
        self.grants_message = Adw.StatusPage(icon_name="dialog-warning-symbolic")
        self.grants_stack.add_named(self.grants_message, "message")
