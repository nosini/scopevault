#!/usr/bin/python3
"""Graphical front end for scopevault-admin.

A host program only: the daemon's administrative socket refuses sandboxed
callers, so this must never be packaged as a Flatpak. It runs
`scopevault-admin ... --json` for every request and never asks for or
handles a password: the daemon asks in its own dialog.

Labels and attributes are chosen by applications, so they are shown as
plain text only (never Pango markup), with control and bidirectional
formatting characters replaced.

Every admin request is logged by the daemon, and listing scopes, items or
grants of a locked vault opens the unlock dialog. So nothing is polled:
the window reads the status first, lists only an unlocked vault, and
refreshes after each operation or on request. The daemon serves at most
four clients at once; reads run one after another, and only one operation
runs at a time. Reads that an operation overtook (a lock, say) stop
there, and the refresh after the operation starts again from the status.
"""

import argparse
import json
import os
import re
import sys
import time
import unicodedata
from collections.abc import Callable
from typing import Any

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk, Pango

APP_ID = "eu.nosini.ScopeVault"
# The daemon's error message for a cancelled password dialog
# (src/admin/protocol.rs, CANCELLED).
CANCELLED = "cancelled in the password dialog"
# What scopevault-admin accepts as a scope; the daemon checks app IDs
# exactly. This keeps typos and anything resembling an option out of the
# argument list.
SCOPE_RE = re.compile(r"(host|portal|flatpak/[A-Za-z_][A-Za-z0-9_.-]{0,254})")
OTHER_SCOPE = "Other scope…"
MAX_SHOWN = 300

Reply = dict[str, Any]

# Characters that could make one label look like another: bidirectional
# overrides, isolates and marks.
BIDI = set("\u061c\u200e\u200f\u202a\u202b\u202c\u202d\u202e\u2066\u2067\u2068\u2069")


def plain(text: str, limit: int = MAX_SHOWN) -> str:
    """App-controlled text, made safe to show in a plain-text label: line
    breaks (including the Unicode line and paragraph separators) become
    spaces, control and bidirectional formatting characters U+FFFD."""
    out = []
    for c in text:
        if c in "\n\t\r\u2028\u2029":
            out.append(" ")
        elif c in BIDI or unicodedata.category(c) == "Cc":
            out.append("\ufffd")
        else:
            out.append(c)
    s = "".join(out)
    return s if len(s) <= limit else s[:limit] + "…"


def when(secs: int) -> str:
    return time.strftime("%Y-%m-%d %H:%M", time.localtime(secs))


def text_row(title: str, subtitle: str = "") -> Adw.ActionRow:
    """A row that shows its title and subtitle as plain text."""
    row = Adw.ActionRow(use_markup=False)
    row.set_title(title)
    if subtitle:
        row.set_subtitle(subtitle)
    return row


def text_label(text: str, *classes: str) -> Gtk.Label:
    label = Gtk.Label(use_markup=False, xalign=0, wrap=True, selectable=True)
    label.set_text(text)
    for c in classes:
        label.add_css_class(c)
    return label


def later(fn: Callable[[], None]) -> None:
    """Runs `fn` from the main loop, as an asynchronous result would."""

    def once() -> bool:
        fn()
        return GLib.SOURCE_REMOVE

    GLib.idle_add(once)


class Admin:
    """Runs scopevault-admin with --json; every call ends with one reply."""

    def __init__(self, program: str | None, socket: str | None) -> None:
        self.program = program
        self.socket = socket

    def run(self, args: list[str], done: Callable[[Reply], None]) -> None:
        if self.program is None:
            later(lambda: done(error("scopevault-admin was not found")))
            return
        argv = [self.program]
        if self.socket:
            argv += ["--socket", self.socket]
        argv += args + ["--json"]
        flags = Gio.SubprocessFlags.STDIN_PIPE | Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
        try:
            proc = Gio.Subprocess.new(argv, flags)
        except GLib.Error as e:
            message = f"cannot run {self.program}: {e.message}"
            later(lambda: done(error(message)))
            return

        def finished(p: Gio.Subprocess, result: Gio.AsyncResult) -> None:
            try:
                _, out, err = p.communicate_utf8_finish(result)
            except GLib.Error as e:
                done(error(f"scopevault-admin failed: {e.message}"))
                return
            reply = None
            try:
                reply = json.loads(out or "")
            except ValueError:
                pass
            if not isinstance(reply, dict) or not isinstance(reply.get("reply"), str):
                message = (err or "").strip() or f"scopevault-admin exited with status {p.get_exit_status()}"
                reply = error(message)
            done(reply)

        proc.communicate_utf8_async(None, None, finished)


def error(message: str) -> Reply:
    return {"reply": "error", "message": message}


def is_error(reply: Reply) -> bool:
    return reply.get("reply") == "error"


def flatpak_app_ids() -> list[str]:
    """Apps that have run at some point; only a hint for choosing a scope."""
    try:
        names = os.listdir(os.path.expanduser("~/.var/app"))
    except OSError:
        return []
    return sorted(f"flatpak/{n}" for n in names if SCOPE_RE.fullmatch(f"flatpak/{n}"))


class ScopeChooser(Gtk.Box):
    """Pick a scope from a list, or type another one."""

    def __init__(self, choices: list[str], on_change: Callable[[], None]) -> None:
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.choices = choices
        self.dropdown = Gtk.DropDown.new_from_strings(choices + [OTHER_SCOPE])
        self.entry = Gtk.Entry(placeholder_text="flatpak/org.example.App", visible=False)
        self.append(self.dropdown)
        self.append(self.entry)

        def changed(*_: object) -> None:
            self.entry.set_visible(self.dropdown.get_selected() >= len(self.choices))
            on_change()

        self.dropdown.connect("notify::selected", changed)
        self.entry.connect("changed", changed)
        changed()

    def scope(self) -> str | None:
        i = self.dropdown.get_selected()
        s = self.choices[i] if i < len(self.choices) else self.entry.get_text().strip()
        return s if SCOPE_RE.fullmatch(s) else None


class ScopeRow(Gtk.ListBoxRow):
    def __init__(self, summary: Reply) -> None:
        super().__init__()
        self.scope: str = summary["scope"]
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, margin_top=6, margin_bottom=6)
        name = Gtk.Label(use_markup=False, xalign=0, ellipsize=Pango.EllipsizeMode.END)
        name.set_text(plain(self.scope))
        box.append(name)
        count = Gtk.Label(use_markup=False, xalign=0)
        count.set_text(f"{summary['items']} items in {summary['collections']} collections")
        count.add_css_class("dim-label")
        count.add_css_class("caption")
        box.append(count)
        self.set_child(box)


class Window(Adw.ApplicationWindow):
    def __init__(self, app: Adw.Application, admin: Admin) -> None:
        super().__init__(application=app, title="ScopeVault", default_width=980, default_height=680)
        self.admin = admin
        self.status: Reply | None = None
        self.scopes: list[Reply] = []
        self.grants: list[Reply] = []
        self.selected: str | None = None
        # The listing shown, as (scope, collections).
        self.listing: tuple[str, list[Reply]] | None = None
        self.checked: set[str] = set()
        self.busy = False
        # Bumped when an operation starts. A read that was sent before, or
        # while one runs, describes a vault that may have changed (a lock):
        # its reply must not lead to further reads, which on a locked vault
        # open the unlock dialog.
        self.generation = 0
        self.refreshing = False
        self.refresh_again = False
        # The scope a listing request is out for, and whether its reply is
        # already outdated (an operation finished meanwhile).
        self.listing_for: str | None = None
        self.listing_stale = False
        # Rebuilding the scope list emits row-selected; ignore it then.
        self.rebuilding = False

        self.actions: dict[str, Gio.SimpleAction] = {}
        for name, param, handler in [
            ("refresh", None, lambda *_: self.refresh()),
            ("lock", None, lambda *_: self.do_lock()),
            ("unlock", None, lambda *_: self.do_unlock()),
            ("change-password", None, lambda *_: self.do_change_password()),
            ("backup", None, lambda *_: self.do_backup()),
            ("move", None, lambda *_: self.do_move()),
            ("reset-scope", None, lambda *_: self.do_reset_scope()),
            ("share", "s", lambda _a, p: self.do_share(p.get_string())),
            ("unshare", "s", lambda _a, p: self.do_unshare(p.get_string())),
        ]:
            action = Gio.SimpleAction.new(name, GLib.VariantType.new(param) if param else None)
            action.connect("activate", handler)
            self.add_action(action)
            self.actions[name] = action

        self.toasts = Adw.ToastOverlay()
        self.banner = Adw.Banner(use_markup=False)
        self.stack = Adw.ViewStack()
        self.stack.add_titled_with_icon(self.build_vault_page(), "vault", "Vault", "channel-secure-symbolic")
        self.stack.add_titled_with_icon(self.build_scopes_page(), "scopes", "Scopes", "folder-symbolic")
        self.stack.add_titled_with_icon(self.build_grants_page(), "grants", "Sharing", "emblem-shared-symbolic")

        header = Adw.HeaderBar()
        header.set_title_widget(Adw.ViewSwitcher(stack=self.stack, policy=Adw.ViewSwitcherPolicy.WIDE))
        refresh = Gtk.Button(icon_name="view-refresh-symbolic", action_name="win.refresh", tooltip_text="Refresh")
        header.pack_start(refresh)

        view = Adw.ToolbarView()
        view.add_top_bar(header)
        view.add_top_bar(self.banner)
        self.toasts.set_child(self.stack)
        view.set_content(self.toasts)
        self.set_content(view)

        self.update_actions()
        if admin.program is None:
            self.show_status(error("scopevault-admin was not found next to scopevault-gui or on PATH"))
        else:
            self.refresh()

    # Pages

