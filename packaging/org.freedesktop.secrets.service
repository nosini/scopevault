# D-Bus activation for scopevault. Install as
# ~/.local/share/dbus-1/services/org.freedesktop.secrets.service.
# dbus-broker reads the user directory before /usr/share, and the first
# definition of a name wins, so this replaces gnome-keyring's file.
# Activation goes through systemd; Exec is only a fallback that fails.
[D-BUS Service]
Name=org.freedesktop.secrets
Exec=/bin/false
SystemdService=scopevault.service
