# Stops the autostart entry that starts gnome-keyring's secrets component.
# Install as ~/.config/autostart/gnome-keyring-secrets.desktop; it overrides
# /etc/xdg/autostart/gnome-keyring-secrets.desktop. PAM still starts
# gnome-keyring-daemon, which leaves the name alone until something asks for
# its secrets component.
[Desktop Entry]
Type=Application
Name=Secret Storage Service
Hidden=true
